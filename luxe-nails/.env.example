# Where .env is read from:
# - Running from source (python app.py in luxe-nails): this file in luxe-nails/ is used (same folder as app.py).
# - Installed macOS app: copy or symlink this file to:
#     ~/Library/Application Support/NailQue/.env
# - Installed Windows app: copy this file to:
#     %APPDATA%\NailQue\.env
#   Or set an absolute path in the environment before launch:
#     NAILQUE_ENV_FILE=/path/to/luxe-nails/.env
#
# Change these in the first-run setup wizard. They are only used as labels if you
# skip the wizard in tests.
MANAGER_PIN=1234
MANAGER_USERNAME=admin
MANAGER_FULL_NAME=Admin User
PORT=5001
HOST=0.0.0.0
# Only enable if NailQue is behind a trusted reverse proxy.
TRUST_PROXY=false
AUTO_UPDATE_ENABLED=true
# Required for OTA. Do not leave blank (AUTO_UPDATE_REPO= disables updates in older builds).
AUTO_UPDATE_REPO=your-org/your-repo
AUTO_UPDATE_CHECK_INTERVAL_SECONDS=900
AUTO_UPDATE_INCLUDE_PRERELEASE=false
# Optional. Auto-generated in the runtime folder when omitted.
# SECRET_KEY=
# Optional LAN HTTPS. Point these at a PEM cert/key pair (see docs/SIGNING.md).
# SSL_CERTFILE=
# SSL_KEYFILE=
