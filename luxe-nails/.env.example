# Where .env is read from:
# - Running from source (python app.py in luxe-nails): this file in luxe-nails/ is used (same folder as app.py).
# - Installed NailQue.app: copy or symlink this file to:
#     ~/Library/Application Support/NailQue/.env
#   Or set an absolute path in the environment before launch:
#     NAILQUE_ENV_FILE=/path/to/luxe-nails/.env
#
# Optional: default PIN used if manager_settings.json does not exist yet
MANAGER_PIN=1234
PORT=5001
HOST=0.0.0.0
AUTO_UPDATE_ENABLED=true
# Required for OTA. Do not leave blank (AUTO_UPDATE_REPO= disables updates in older builds).
AUTO_UPDATE_REPO=your-org/your-repo
AUTO_UPDATE_CHECK_INTERVAL_SECONDS=900
AUTO_UPDATE_INCLUDE_PRERELEASE=false
